DATABASE_URL="postgresql://user:password@localhost:5432/margebar"
# 32 characters minimum. Required whenever NODE_ENV is not development/test.
JWT_SECRET="your-secret-key-change-in-production"
# development (or test) on your machine ONLY. The server MUST run with NODE_ENV=production:
# it turns on env validation, the HTTPS redirect, the CORS lock, upgrade-insecure-requests and
# the production rate limits (10 sign-ups per hour per IP).
NODE_ENV=development
PORT=3000
# ANTHROPIC_API_KEY is no longer used (the scan runs Tesseract OCR on the server): remove it.
