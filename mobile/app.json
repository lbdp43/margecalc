{
  "expo": {
    "name": "MargeBar Pro",
    "slug": "margebar",
    "version": "3.14.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F6F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.margebar.app"
    },
    "android": {
      "package": "com.margebar.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F6F4"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#F3F6F4",
      "themeColor": "#F3F6F4",
      "name": "MargeBar Pro",
      "shortName": "MargeBar",
      "lang": "fr"
    },
    "backgroundColor": "#F3F6F4",
    "primaryColor": "#087553",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "MargeBar Pro accède à vos photos pour importer la photo d’une bouteille ou d’une facture.",
          "cameraPermission": "MargeBar Pro utilise l’appareil photo pour scanner une bouteille ou une facture.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
